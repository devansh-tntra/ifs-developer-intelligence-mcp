# IFS Developer Intelligence MCP Server Environment Configuration

# Primary IFS Documentation Base URL
IFS_DOCS_URL=https://docs.ifs.com/techdocs/
IFS_DOCS_VERSION=26R1

# Local Workspace Directory to Index (e.g. d:/Project/clauger/clauger)
IFS_WORKSPACE_PATH=d:/Project/clauger/clauger

# Server Configuration
PORT=3000
MCP_TRANSPORT=stdio
LOG_LEVEL=info

# Optional Embedding API Key (Fallback to local TF-IDF vectorizer if empty)
OPENAI_API_KEY=
