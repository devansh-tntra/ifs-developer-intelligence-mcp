{
  "name": "ifs-developer-intelligence-mcp",
  "version": "1.0.0",
  "description": "Enterprise-grade Model Context Protocol (MCP) server for IFS Cloud technical documentation, Marble DSL, PL/SQL, Oracle errors, and workspace intelligence.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:sse": "node dist/index.js --transport sse",
    "dev": "ts-node-esm src/index.ts",
    "crawl": "ts-node-esm src/scripts/crawlDocs.ts",
    "index:workspace": "ts-node-esm src/scripts/indexWorkspace.ts",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ifs-cloud",
    "ifs-developer-studio",
    "marble-dsl",
    "plsql",
    "oracle",
    "rag",
    "ai-assistant"
  ],
  "author": "IFS AI Platform Engineering",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.3.5",
    "glob": "^10.3.10",
    "pdf-parse": "^1.1.1",
    "turndown": "^7.1.3",
    "yaml": "^2.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pdf-parse": "^1.1.4",
    "@types/turndown": "^5.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
