{
  "mcpServers": {
    "ifs-developer-intelligence-cloud": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://ifs-mcp-server.onrender.com/sse"
      ]
    },
    "ifs-developer-intelligence-local": {
      "command": "node",
      "args": [
        "./dist/index.js"
      ],
      "env": {
        "IFS_DOCS_VERSION": "ALL",
        "IFS_WORKSPACE_PATH": "./"
      }
    }
  }
}
