        <di:waypoint x="610" y="240" />
        <di:waypoint x="672" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1k451e4_di" bpmnElement="Flow_1k451e4">
        <di:waypoint x="450" y="240" />
        <di:waypoint x="510" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0hvoots_di" bpmnElement="Flow_0hvoots">
        <di:waypoint x="290" y="240" />
        <di:waypoint x="350" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0jwpl0r_di" bpmnElement="Flow_0jwpl0r">
        <di:waypoint x="138" y="240" />
        <di:waypoint x="190" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="102" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0vnk7l2_di" bpmnElement="Activity_188h7qz">
        <dc:Bounds x="190" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0sopsrs_di" bpmnElement="Activity_0ma1ope">
        <dc:Bounds x="350" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1038yp2_di" bpmnElement="Activity_1nqv1pb">
        <dc:Bounds x="510" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0vudois_di" bpmnElement="Event_0vudois">
        <dc:Bounds x="672" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
