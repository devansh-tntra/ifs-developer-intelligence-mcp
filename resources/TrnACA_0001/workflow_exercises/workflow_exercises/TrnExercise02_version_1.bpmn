            </camunda:map>
          </camunda:inputParameter>
          <camunda:inputParameter name="ifsBpaImplType">
            <camunda:map>
              <camunda:entry key="en">Type</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
