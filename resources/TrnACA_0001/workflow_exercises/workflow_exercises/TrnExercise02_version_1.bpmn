    <bpmn:serviceTask id="Activity_17z7i06" name="Create Company Founder" camunda:class="com.ifsworld.fnd.bpa.IfsProjectionDelegate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="ifsBpaProjectionETagVariableName">ETag</camunda:inputParameter>
          <camunda:inputParameter name="ifsBpaProjectionType">Standard</camunda:inputParameter>
          <camunda:inputParameter name="ifsBpaProjectionAction">CREATE</camunda:inputParameter>
          <camunda:inputParameter name="ifsBpaProjectionName">TrnCompanyFounderHandling</camunda:inputParameter>
          <camunda:inputParameter name="ifsBpaProjectionEntitySetName">TrnCompanyFounderSet</camunda:inputParameter>
          <camunda:inputParameter name="ifsBpaProjectionParameters">
            <camunda:map>
              <camunda:entry key="Cf_Est_Date">${Date}</camunda:entry>
              <camunda:entry key="Cf_Name">${Name}</camunda:entry>
              <camunda:entry key="Cf_Notes">${Notes}</camunda:entry>
            </camunda:map>
          </camunda:inputParameter>
          <camunda:inputParameter name="ifsBpaProjectionIsETag" />
          <camunda:inputParameter name="ifsBpaIsOnlyExplicitParameters" />
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02h502i</bpmn:incoming>
      <bpmn:outgoing>Flow_178gdck</bpmn:outgoing>
