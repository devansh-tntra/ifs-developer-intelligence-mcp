    <bpmn:userTask id="Activity_17uc309" name="Input Values to Create Company Founder" camunda:formKey="CreateCompanyFounder">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="Name" type="string" />
          <camunda:formField id="Date" type="date" />
          <camunda:formField id="Notes" type="string">
            <camunda:properties>
              <camunda:property id="isText" value="false" />
            </camunda:properties>
          </camunda:formField>
          <camunda:formField id="Type" type="enum">
            <camunda:value id="INT" name="Internal" />
            <camunda:value id="EXT" name="External" />
          </camunda:formField>
        </camunda:formData>
        <camunda:inputOutput>
          <camunda:inputParameter name="ifsBpaImplName">
            <camunda:map>
              <camunda:entry key="en">Name</camunda:entry>
            </camunda:map>
