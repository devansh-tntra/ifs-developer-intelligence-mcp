    <bpmn:sequenceFlow id="Flow_0lezznx" name="When Tax rate &#62; 49%" sourceRef="Gateway_0h76v36" targetRef="Event_0bignh8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${FeeRate &gt; 49}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1n151bf">
      <bpmn:incoming>Flow_1pj2pi2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1pj2pi2" sourceRef="Gateway_0h76v36" targetRef="Event_1n151bf" />
    <bpmn:endEvent id="Event_1kbk2sb">
