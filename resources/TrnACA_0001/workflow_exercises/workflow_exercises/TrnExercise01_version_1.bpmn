  <bpmn:process id="TrnExercise01" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_021x5k4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1sztucr" default="Flow_1gkom8b">
      <bpmn:incoming>Flow_021x5k4</bpmn:incoming>
      <bpmn:outgoing>Flow_0sjelf3</bpmn:outgoing>
      <bpmn:outgoing>Flow_1gkom8b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_021x5k4" sourceRef="StartEvent_1" targetRef="Gateway_1sztucr" />
    <bpmn:sequenceFlow id="Flow_0sjelf3" name="When Tax rate &#60; 12.5%" sourceRef="Gateway_1sztucr" targetRef="Event_1kbk2sb">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${FeeRate &lt; 12.5}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0h76v36" default="Flow_1pj2pi2">
