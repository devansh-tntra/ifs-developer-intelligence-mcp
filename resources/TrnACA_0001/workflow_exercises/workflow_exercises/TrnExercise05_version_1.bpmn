      <bpmn:outgoing>Flow_0z4zn18</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="IncomeTypeCollection" camunda:elementVariable="item" />
      <bpmn:startEvent id="Event_1dox3b7">
        <bpmn:outgoing>Flow_1gsxseh</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_1gsxseh" sourceRef="Event_1dox3b7" targetRef="Activity_0jlbegq" />
      <bpmn:endEvent id="Event_18n24z1">
        <bpmn:incoming>Flow_0bnyybm</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0bnyybm" sourceRef="Activity_0jlbegq" targetRef="Event_18n24z1" />
      <bpmn:scriptTask id="Activity_0jlbegq" name="Read Income Type" scriptFormat="JavaScript">
        <bpmn:incoming>Flow_1gsxseh</bpmn:incoming>
        <bpmn:outgoing>Flow_0bnyybm</bpmn:outgoing>
        <bpmn:script>execution.setVariable('modifiedIncomeTypeDesc', 'Modified ' + item.Description);</bpmn:script>
      </bpmn:scriptTask>
    </bpmn:subProcess>
    <bpmn:endEvent id="Event_1gayvzv">
      <bpmn:incoming>Flow_0z4zn18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0z4zn18" sourceRef="Activity_09ivbjr" targetRef="Event_1gayvzv" />
  </bpmn:process>
