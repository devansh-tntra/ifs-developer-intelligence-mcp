-----------------------------------------------------------------------------

layer Core;

----------------------------- ENTITY PROCEDURES -----------------------------

@Override
procedure EntityPrepare<TrnWorkOrder> {
   execute {
      super(Record) into Record;
      set Record.Description = "Generated Description for offline";
      return Record;
   }
}

@Override
procedure EntityInsert<TrnWorkOrder> {
   variable SysDate Date;
   execute {
      call ValidateWoCreationDate(Record);
      super(Record);
   }
}

@Override
procedure EntityUpdate<TrnWorkOrder> {
   variable SysDate Date;
   execute {
      call ValidateWoCreationDate(Record);
      super(Record);
   }
}

procedure ValidateWoCreationDate {
   parameter Record Structure(TrnWorkOrder);
   variable SysDate Date;
   execute {
      call DateTime.Date() into SysDate;
      if [Record.CreationDate > SysDate] {
         error("APPCREATIONDATEERR: Creation Date of the Work Order cannot be later than the current date.", "Record.CreationDate");
      }
   }
}

---------------------------- FUNCTION PROCEDURES ----------------------------
@Override
procedure Function<GetStepCount> Number {
   variable StepCount Number;
   execute {
      super(WoNo);
      count WorkOrderSteps wo where [wo.WorkOrderNo = WoNo] into StepCount;
      return StepCount;
   }
}

@Overtake Base
procedure Function<GetWoUrl> Text {
   parameter WoNo Number;
   variable WoUrl;
   variable BaseUrl;
   execute {
      call System.GetParameter("ExtServerUrl") into BaseUrl;
      call String.Replace("{base_url}/main/ifsapplications/web/page/TrnmwoWorkOrderManagement/WorkOrderDetailsPage;$filter=WorkOrderNo%20eq%20{wo_id}", "{base_url}", BaseUrl) into WoUrl;
      call String.Replace(WoUrl, "{wo_id}", WoNo) into WoUrl;
      return WoUrl;
   }
}

procedure Function<GetUserInfo> Text {
   variable CurrentUser;
   execute {
      call System.GetParameter("UserId") into CurrentUser;
      return CurrentUser;
   }
}
----------------------------- ACTION PROCEDURES -----------------------------
@Override
procedure Action<WoChangeDescription> {
   variable WoRecord Structure(TrnWorkOrder);
   variable FWEntitySetName Text;
   execute {
      set FWEntitySetName = "WorkOrders";

      fetch WorkOrders wo where[wo.WorkOrderNo = WoNo] into WoRecord;
      set WoRecord.Description = "Offline Description Change";
      saveAndSend WoRecord;
      super(WoNo);
   }
}

@Override
procedure Action<TrnWorkOrder.FillNullValues> {
   execute {
      if[Record.Comments = null]
         {
         set Record.Comments = "Client - Added value";
      }
      if[Record.TaskUrl = null]
         {
         set Record.TaskUrl = "https://www.google.com";
      }
      saveAndSend Record;
      super(Record);
   }
}