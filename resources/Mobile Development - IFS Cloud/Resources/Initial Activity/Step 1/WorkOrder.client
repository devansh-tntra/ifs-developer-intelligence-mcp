-------------------------------- SINGLETONS ---------------------------------


---------------------------------- CHARTS -----------------------------------


--------------------------------- CALENDERS ---------------------------------


---------------------------------- SHEETS -----------------------------------


----------------------------- STATE INDICATORS ------------------------------
@Overtake Base
stateindicator TrnWorkOrderStateIndicator for TrnWorkOrder {
   state "New" {
      completed = 0%;
      emphasis Complementary2 = [Objstate = "New"];
   }

   state "Assigned" {
      completed = 20%;
      emphasis Complementary3 = [Objstate = "Assigned"];
   }

   state "Accepted" {
      completed = 40%;
      emphasis Complementary6 = [Objstate = "Accepted"];
   }

   state "Travel" {
      completed = 60%;
      emphasis Complementary1 = [Objstate = "Travel"];
   }
   state "ReachedSite" {
      completed = 80%;
      emphasis Complementary1 = [Objstate = "ReachedSite"];
   }

   state "Completed" {
      completed = 100%;
      emphasis Complementary9 = [Objstate = "Completed"];
   }
}

