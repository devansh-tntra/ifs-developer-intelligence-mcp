client WorkOrder;
component TRNMWO;
layer Core;
projection WorkOrder;
description "Put some useful description here ...";
target AurenaNative;


--------------------------------- FRAGMENTS ---------------------------------

----------------------------- NAVIGATOR ENTRIES -----------------------------
navigator
   {

   entry WorkOrderEntry toplevel at  index  100 {
      --Needs to change later
      entry WorkOrderOverviewPageNavEntry;
      --Add other Entries to Navigation
   }


   entry WorkOrderDetailsPageNavEntry
      {
      label = "Work Order Details";
      page WorkOrderDetailsPage;
      icon = "account-type";
   }

   entry WorkOrderOverviewPageNavEntry
      {
      label = "Work Orders";
      page WorkOrderOverviewPage;
      icon = "tools-solid";
      count = WorkOrders;
   }

      --Add CustomerverviewPageNavEntry
      --Add TechnicianOverviewPageNavEntry
}

-------------------------------- MAIN PAGES ---------------------------------
page WorkOrderDetailsPage using WorkOrders
   {
   label = "Work Order Details";
   stateindicator TrnWorkOrderStateIndicator;
   selector TrnWorkOrderSelector;
   group WorkOrderGroup bind TrnWorkOrderSelector;
   list WorkOrderStepList(Steps) bind TrnWorkOrderSelector;

   commandgroup StateChanges {
      command Assign;
      command Accept;
      command Start;
      command StartTravel;
      command OnSite;
      command Complete;
   }
   --command CommandGetStepCount;
   --command CommandWoChangeDescription;
   --command CommandFillNullValues;
   --command CommandOpenWoPage;
   --command CommandGetUserInfo;
   --command CommandGenerateReport;
}

page WorkOrderOverviewPage  using WorkOrders
   {
   label = "Work Order Overview";
   list WorkOrderList {
      label = "Work Orders";
      details = WorkOrderDetailsPage(WorkOrderNo);
   }
   attachments {
      enabled = [true];
   }

}

--Create CustomerOverviewPage using Customers
--Create TechnicianOverviewPage using Technicians and set Details Page
--Create TechnicianDetailsPage using Technicians


--------------------------------- COMMANDS ----------------------------------
--Add CommandGetStepCount for TrnWorkOrder
--Add CommandWoChangeDescription for TrnWorkOrder
--Add CommandFillNullValues for TrnWorkOrder
--Add CommandOpenWoPage for TrnWorkOrder
--Add CommandGetUserInfo




command CommandGenerateReport
   {
   label = "Print Report";
   icon = "book";
   execute {
      print WorkOrderDetailsPage
         {
         filter(WorkOrderNo, WorkOrderNo);
      }
   }
}



--------------------------------- SELECTORS ---------------------------------
@Overtake
selector TrnWorkOrderSelector for TrnWorkOrder {
   label = "${WorkOrderNo} -${Description}-${Objstate}";
   static WorkOrderNo;
   static Description;
   badge Objstate {
      style = TextOnly;
      label = "Status";
      showlabel = false;
   }
}

---------------------------------- GROUPS -----------------------------------
group WorkOrderGroup for TrnWorkOrder {
   label = "Work Order Details";
   badge      WorkOrderNo {
      emphasis Complementary1 = [true];
   }
   field      Description;
   field      CreationDate;
   field      Comments;
   field      CompanyId;
   badge      Objstate {
      emphasis Complementary5 = [true];
   }
   field      CustomerRef {
      label = "Customer Id";
   }
   field      TechnicianRef {
      label = "Technician Id";
   }
   field      AssigneeRef {
      label = "Assignee Id";
   }
   field TaskUrl {
      fieldhint = Url;
   }

}

--Create Group for TechnicianGroup


----------------------------------- LISTS -----------------------------------
list WorkOrderList for TrnWorkOrder {

   label = "";
   card WorkOrderCard;

}

list WorkOrderStepList for TrnWorkOrderStep {
   label = "Work Order Steps";
   field    WorkOrderNo;
   field    StepId;
   field    InstructionRef;
   field    SequenceNo;
   field    IsDone;

}

card WorkOrderCard for TrnWorkOrder {
   label = "Work Order-${WorkOrderNo}-${Description}-${Objstate}";

   markdowntext {
      visible = [Objstate = "New"];
      text = "New Work Order!";
      emphasis Complementary2 = [true];
   }

   badge      WorkOrderNo {
      emphasis Complementary1 = [true];
   }
   field      Description;
   field      CreationDate;
   field      Comments;
   field      CompanyId;
   badge      Objstate {
      emphasis Complementary5 = [true];
   }
   field      CustomerRef {
      label = "Customer Id";
   }
   field      TechnicianRef {
      label = "Technician Id";
   }
   field      AssigneeRef {
      label = "Assignee Id";
	   contactwidget {
         enabled = [true];
         source = Person;
      }
   }
   field TaskUrl {
      fieldhint = Url;
   }


   commandgroup StateChanges {
      command Assign {
         emphasis Complementary1 = [true];
      }
      command Accept {
         emphasis Complementary2 = [true];
      }
      command Start {
         emphasis Complementary3 = [true];
      }
      command StartTravel {
         emphasis Complementary4 = [true];
      }
      command OnSite {
         emphasis Complementary5 = [true];
      }
      command Complete {
         emphasis Complementary6 = [true];
      }
   }
   --command CommandGetStepCount;
  -- command CommandWoChangeDescription;
  -- command CommandOpenWoPage;
}

--Create list CustomerList for TrnCustomer
--Create list TechnicianList  for TrnTechnician


card TechnicianCard  for TrnTechnician
   {
   label = "";
   markdowntext {
      text = "**${Name}**";
   }
   field PersonId;
   field Name;
}

