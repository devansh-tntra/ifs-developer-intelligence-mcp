--------------------------------- SELECTORS ---------------------------------


---------------------------------- GROUPS -----------------------------------


----------------------------------- LISTS -----------------------------------
list TrnCustomerList for TrnCustomer {
   field CompanyId;
   field CustomerId;
   field Name;
   field CreditLimit;
   field Discount;
   field Active;
   field Comments;
}


