client CustomerOrder;
component TRNORD;
layer Core;
projection OrderBasicData;
description "Client for Customer Order";

--------------------------------- FRAGMENTS ---------------------------------

----------------------------- NAVIGATOR ENTRIES -----------------------------
entry TrnCustomerPageNavEntry parent TrnordNavigatorRoot.ManageCustomers at index 100 {
   label = "Customers";
   page TrnCustomerPage;

}

-------------------------------- MAIN PAGES ---------------------------------
page TrnCustomerPage {
   list TrnCustomerList using TrnCustomers;
}


